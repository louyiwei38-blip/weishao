{
  "name": "polymarket-vegas-bot",
  "version": "1.0.0",
  "description": "BTC/USDT Vegas channel Polymarket bot (5m/15m/1h CLOB V2)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "start:15m": "node scripts/run-instance.js 15m",
    "start:5m": "node scripts/run-instance.js 5m",
    "start:1h": "node scripts/run-instance.js 1h",
    "dry": "node scripts/run-instance.js 1h --dry",
    "dry:15m": "node scripts/run-instance.js 15m --dry",
    "dry:5m": "node scripts/run-instance.js 5m --dry",
    "dry:1h": "node scripts/run-instance.js 1h --dry",
    "encrypt-key": "node scripts/encrypt-key.js",
    "create-api-key": "node scripts/create-api-key.js",
    "test-cycle": "node scripts/test-cycle.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env live",
    "pm2:dry": "pm2 start ecosystem.config.cjs --env dry",
    "pm2:restart": "pm2 restart V3-5m V3-15m V3-1h",
    "pm2:stop": "pm2 stop V3-5m V3-15m V3-1h",
    "pm2:logs": "pm2 logs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@polymarket/builder-relayer-client": "^0.0.10",
    "@polymarket/clob-client": "^5.8.1",
    "@polymarket/clob-client-v2": "^1.0.6",
    "ccxt": "^4.5.51",
    "dotenv": "^16.4.5",
    "viem": "^2.21.0",
    "winston": "^3.13.0",
    "ws": "^8.18.0"
  }
}
