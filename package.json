{
  "name": "polymarket-vegas-bot",
  "version": "1.0.0",
  "description": "Vegas channel Polymarket bot (single symbol×TF by default; shared bankroll + catch-up queue)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "start:15m": "node scripts/run-instance.js 15m --symbol=BTC/USDT",
    "start:5m": "node scripts/run-instance.js 5m --symbol=BTC/USDT",
    "start:1h": "node scripts/run-instance.js 1h --symbol=BTC/USDT",
    "start:btc:5m": "node scripts/run-instance.js 5m --symbol=BTC/USDT",
    "start:btc:15m": "node scripts/run-instance.js 15m --symbol=BTC/USDT",
    "start:btc:1h": "node scripts/run-instance.js 1h --symbol=BTC/USDT",
    "start:eth:5m": "node scripts/run-instance.js 5m --symbol=ETH/USDT",
    "start:eth:15m": "node scripts/run-instance.js 15m --symbol=ETH/USDT",
    "start:eth:1h": "node scripts/run-instance.js 1h --symbol=ETH/USDT",
    "start:eth:5m:jz": "node scripts/run-instance.js 5m --symbol=ETH/USDT --strategy=jz",
    "start:eth:15m:jz": "node scripts/run-instance.js 15m --symbol=ETH/USDT --strategy=jz",
    "start:eth:1h:jz": "node scripts/run-instance.js 1h --symbol=ETH/USDT --strategy=jz",
    "start:btc:5m:jz": "node scripts/run-instance.js 5m --symbol=BTC/USDT --strategy=jz",
    "dry": "node scripts/run-instance.js 1h --dry --symbol=BTC/USDT",
    "dry:15m": "node scripts/run-instance.js 15m --dry --symbol=BTC/USDT",
    "dry:5m": "node scripts/run-instance.js 5m --dry --symbol=BTC/USDT",
    "dry:1h": "node scripts/run-instance.js 1h --dry --symbol=BTC/USDT",
    "encrypt-key": "node scripts/encrypt-key.js",
    "create-api-key": "node scripts/create-api-key.js",
    "test-cycle": "node scripts/test-cycle.js",
    "verify:fast-path": "node scripts/verify-fast-path.js",
    "setup:tg-topics": "node scripts/setup-telegram-topics.js",
    "test:telegram": "node scripts/test-telegram.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env live",
    "pm2:dry": "pm2 start ecosystem.config.cjs --env dry",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:btc:start": "pm2 start ecosystem.config.cjs --only V3-btc-5m,V3-btc-5m-jz --env live",
    "pm2:btc:dry": "pm2 start ecosystem.config.cjs --only V3-btc-5m,V3-btc-5m-jz --env dry",
    "pm2:eth:start": "pm2 start ecosystem.config.cjs --only V3-eth-5m,V3-eth-5m-jz --env live",
    "pm2:eth:dry": "pm2 start ecosystem.config.cjs --only V3-eth-5m,V3-eth-5m-jz --env dry",
    "pm2:logs": "pm2 logs",
    "pm2:w2:start": "pm2 start ecosystem.wallet2.config.cjs --env live",
    "pm2:w2:dry": "pm2 start ecosystem.wallet2.config.cjs --env dry",
    "pm2:w2:restart": "pm2 restart ecosystem.wallet2.config.cjs",
    "pm2:w2:stop": "pm2 stop ecosystem.wallet2.config.cjs",
    "pm2:w2:delete": "pm2 delete ecosystem.wallet2.config.cjs",
    "pm2:w2:btc:start": "pm2 start ecosystem.wallet2.config.cjs --only W2-btc-5m --env live",
    "pm2:w2:btc:dry": "pm2 start ecosystem.wallet2.config.cjs --only W2-btc-5m --env dry",
    "pm2:w2:logs": "pm2 logs W2-btc-5m",
    "manual:tracker": "node scripts/build-manual-tracker-client.cjs && node scripts/manual-tracker-server.js",
    "pm2:manual:start": "node scripts/build-manual-tracker-client.cjs && pm2 start ecosystem.manual-tracker.config.cjs",
    "pm2:manual:restart": "node scripts/build-manual-tracker-client.cjs && pm2 restart manual-tracker",
    "pm2:manual:stop": "pm2 stop manual-tracker",
    "pm2:manual:logs": "pm2 logs manual-tracker"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@polymarket/builder-relayer-client": "^0.0.10",
    "@polymarket/clob-client": "^5.8.1",
    "@polymarket/clob-client-v2": "^1.0.6",
    "ccxt": "^4.5.51",
    "dotenv": "^16.4.5",
    "viem": "^2.21.0",
    "winston": "^3.13.0",
    "ws": "^8.18.0"
  }
}
