{
  "name": "polymarket-vegas-bot",
  "version": "1.0.0",
  "description": "SOL/BNB/XRP/DOGE Vegas channel Polymarket bot (5m/15m/1h CLOB V2)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "start:15m": "node scripts/run-instance.js 15m",
    "start:5m": "node scripts/run-instance.js 5m",
    "start:1h": "node scripts/run-instance.js 1h",
    "start:sol:5m": "node scripts/run-instance.js 5m --symbol=SOL/USDT",
    "start:sol:15m": "node scripts/run-instance.js 15m --symbol=SOL/USDT",
    "start:sol:1h": "node scripts/run-instance.js 1h --symbol=SOL/USDT",
    "start:bnb:5m": "node scripts/run-instance.js 5m --symbol=BNB/USDT",
    "start:bnb:15m": "node scripts/run-instance.js 15m --symbol=BNB/USDT",
    "start:bnb:1h": "node scripts/run-instance.js 1h --symbol=BNB/USDT",
    "start:xrp:5m": "node scripts/run-instance.js 5m --symbol=XRP/USDT",
    "start:xrp:15m": "node scripts/run-instance.js 15m --symbol=XRP/USDT",
    "start:xrp:1h": "node scripts/run-instance.js 1h --symbol=XRP/USDT",
    "start:doge:5m": "node scripts/run-instance.js 5m --symbol=DOGE/USDT",
    "start:doge:15m": "node scripts/run-instance.js 15m --symbol=DOGE/USDT",
    "start:doge:1h": "node scripts/run-instance.js 1h --symbol=DOGE/USDT",
    "dry": "node scripts/run-instance.js 1h --dry",
    "dry:15m": "node scripts/run-instance.js 15m --dry",
    "dry:5m": "node scripts/run-instance.js 5m --dry",
    "dry:1h": "node scripts/run-instance.js 1h --dry",
    "encrypt-key": "node scripts/encrypt-key.js",
    "create-api-key": "node scripts/create-api-key.js",
    "test-cycle": "node scripts/test-cycle.js",
    "verify:fast-path": "node scripts/verify-fast-path.js",
    "setup:tg-topics": "node scripts/setup-telegram-topics.js",
    "test:telegram": "node scripts/test-telegram.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env live",
    "pm2:dry": "pm2 start ecosystem.config.cjs --env dry",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:sol:start": "pm2 start ecosystem.config.cjs --only V3-sol-5m,V3-sol-15m,V3-sol-1h --env live",
    "pm2:sol:dry": "pm2 start ecosystem.config.cjs --only V3-sol-5m,V3-sol-15m,V3-sol-1h --env dry",
    "pm2:bnb:start": "pm2 start ecosystem.config.cjs --only V3-bnb-5m,V3-bnb-15m,V3-bnb-1h --env live",
    "pm2:bnb:dry": "pm2 start ecosystem.config.cjs --only V3-bnb-5m,V3-bnb-15m,V3-bnb-1h --env dry",
    "pm2:xrp:start": "pm2 start ecosystem.config.cjs --only V3-xrp-5m,V3-xrp-15m,V3-xrp-1h --env live",
    "pm2:xrp:dry": "pm2 start ecosystem.config.cjs --only V3-xrp-5m,V3-xrp-15m,V3-xrp-1h --env dry",
    "pm2:doge:start": "pm2 start ecosystem.config.cjs --only V3-doge-5m,V3-doge-15m,V3-doge-1h --env live",
    "pm2:doge:dry": "pm2 start ecosystem.config.cjs --only V3-doge-5m,V3-doge-15m,V3-doge-1h --env dry",
    "pm2:logs": "pm2 logs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@polymarket/builder-relayer-client": "^0.0.10",
    "@polymarket/clob-client": "^5.8.1",
    "@polymarket/clob-client-v2": "^1.0.6",
    "ccxt": "^4.5.51",
    "dotenv": "^16.4.5",
    "viem": "^2.21.0",
    "winston": "^3.13.0",
    "ws": "^8.18.0"
  }
}
