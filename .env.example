# ─────────────────────────────────────────
# Polymarket CLOB V2
# ─────────────────────────────────────────
POLY_ADDRESS=0x...
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=
POLY_BUILDER_CODE=

# 私钥（二选一，服务器推荐用加密方式）
# 方式 A：明文（仅本地开发，勿上传服务器）
# POLY_PRIVATE_KEY=0x...

# 方式 B：加密（推荐服务器）
# 本地运行: npm run encrypt-key
POLY_PRIVATE_KEY_ENCRYPTED=
# 解密密码不要提交 git，在服务器用 export 或 systemd 注入:
# POLY_KEY_PASSWORD=你的强密码

# ─────────────────────────────────────────
# K 线数据源（国内建议 okx，币安常被墙）
# ─────────────────────────────────────────
OHLCV_EXCHANGE=okx
BINANCE_API_KEY=
BINANCE_SECRET=

# ─────────────────────────────────────────
# 策略（固定 BTC 5m）
# ─────────────────────────────────────────
TRADING_SYMBOL=BTC/USDT
CANDLE_TIMEFRAME=5m
CANDLE_FETCH_LIMIT=5
SIGNAL_DELAY_MS=10000

# ─────────────────────────────────────────
# Bot
# ─────────────────────────────────────────
MARKET_CYCLE_MINUTES=5
TRADE_BUDGET_USD=1
MAX_DAILY_LOSS_USD=50
MIN_BALANCE_USD=20
MAX_BET_USD=200
ORDER_TYPE=FOK
DRY_RUN=true
LOG_LEVEL=INFO

# ─────────────────────────────────────────
# 马丁格尔
# ─────────────────────────────────────────
MARTINGALE_MULTIPLIER=2
MARTINGALE_MAX_LOSSES=4

# ─────────────────────────────────────────
# 风控（可选）
# ─────────────────────────────────────────
SKIP_IF_YES_PRICE_OUT_OF_RANGE=true
YES_PRICE_MIN=0.05
YES_PRICE_MAX=0.95
