# ─────────────────────────────────────────
# PMfanz 环境变量模板
# 说明：docs/ARCHITECTURE.md
#
# 标记：[必填-实盘] [二选一] [空跑可省略] [可选] [仅FOK] [未使用]
# 未写明的参数均有代码内默认值，可不放入 .env
# ─────────────────────────────────────────

# ═══════════════════════════════════════════
# [必填-实盘] 私钥 — 空跑(DRY_RUN=true)可全部省略
# ═══════════════════════════════════════════
# 方式 A：明文（仅本地开发）
# POLY_PRIVATE_KEY=0x...                    # Polymarket 钱包私钥（明文，勿提交 git）

# 方式 B：加密（服务器推荐，npm run encrypt-key）
POLY_PRIVATE_KEY_ENCRYPTED=                 # 加密后的私钥（与 POLY_KEY_PASSWORD 配对使用）
# 解密密码（与加密私钥配对；可 export 注入，勿提交 git）
# POLY_KEY_PASSWORD=                          # 解密 POLY_PRIVATE_KEY_ENCRYPTED 的密码

# ═══════════════════════════════════════════
# [可选] CLOB L2 API — 留空则启动时用私钥自动 createOrDeriveApiKey()
# 也可 npm run create-api-key 预生成（启动更快、凭证固定）
# ═══════════════════════════════════════════
# POLY_API_KEY=                               # Polymarket CLOB L2 API Key
# POLY_API_SECRET=                            # Polymarket CLOB L2 API Secret
# POLY_PASSPHRASE=                            # Polymarket CLOB L2 API Passphrase

# ═══════════════════════════════════════════
# [可选] 钱包高级 — 一般留空，程序自动检测
# ═══════════════════════════════════════════
# 资金钱包（留空 → 自动推导 deposit wallet）
# POLY_FUNDER_ADDRESS=0x...                   # Polymarket 资金/代理钱包地址（funder）
# 签名类型 0=EOA 1=PROXY 2=SAFE 3=DEPOSIT_WALLET（留空 → 自动探测）
# POLY_SIGNATURE_TYPE=3                       # 订单签名类型（留空则自动探测）

# ═══════════════════════════════════════════
# 运行模式
# ═══════════════════════════════════════════
# true=模拟下单；false=实盘
DRY_RUN=true                                # 空跑模式：true 只记录不下单，false 实盘交易

# ═══════════════════════════════════════════
# [可选] 信号 K 线 — 默认即可
# ═══════════════════════════════════════════
# 国内服务器建议 okx（默认）；公开 OHLCV 无需 API Key
OHLCV_EXCHANGE=okx                          # K 线数据源：okx / binance / bybit（失败自动切换）

# ═══════════════════════════════════════════
# [可选] 下单 — 默认 GTC 限价
# ═══════════════════════════════════════════
ORDER_TYPE=GTC                              # 订单类型：GTC 限价单 / FOK 市价单
# 以下有默认值，一般不必改：
# TRADE_BUDGET_USD=3                        # 每轮基础下注金额（美元）
# MAX_BET_USD=10000                         # 单笔最大下注金额（美元，含马丁格尔加仓）
# MIN_BALANCE_USD=0                         # 钱包余额低于此值时停止交易（美元）
# MAX_DAILY_LOSS_USD=10000                  # 当日累计亏损达此值时停止交易（美元）
# LIMIT_PRICE_OFFSET_TICKS=0                # 限价单相对最优卖价的 tick 偏移（0=挂在最优卖价）
# FILL_SYNC_POLL_MS=500                     # 下单后轮询成交状态的间隔（毫秒）
# FILL_SYNC_MAX_WAIT_MS=8000                # 下单后等待成交同步的最长时间（毫秒）

# [仅 FOK 市价单生效；GTC 可忽略]
# ORDER_FILL_ATTEMPTS=8                     # FOK 未成交时的最大重试次数
# ORDER_RETRY_DELAY_MS=10000                # FOK 重试之间的等待时间（毫秒）

# ═══════════════════════════════════════════
# [可选] Chainlink 结算 — 默认即可
# ═══════════════════════════════════════════
# CHAINLINK_SETTLE_BUFFER_MS=3000           # 周期结束后等待 Chainlink 结算价的缓冲时间（毫秒）
# CHAINLINK_SETTLE_MAX_WAIT_MS=15000        # 等待 Chainlink 结算价的最长时间（毫秒）
# CHAINLINK_OPEN_WINDOW_MS=5000             # 周期开盘价采集窗口（周期开始后毫秒数）
# CHAINLINK_BUFFER_MINUTES=30               # Chainlink RTDS 价格历史缓存时长（分钟）
# CHAINLINK_SAFETY_INTERVAL_MS=60000        # 结算守护进程的安全检查间隔（毫秒）

# ═══════════════════════════════════════════
# [可选] 策略 — TRADING_SYMBOL 驱动信号 K 线 + Chainlink + Polymarket slug
# ═══════════════════════════════════════════
# TRADING_SYMBOL=BTC/USDT                   # 如 ETH/USDT、SOL/USDT（需 Polymarket 有对应 5m 盘口）
# CANDLE_TIMEFRAME=5m                       # K 线周期
# MARKET_CYCLE_MINUTES=5                    # Polymarket 市场周期（分钟，需与 K 线周期一致）
# CANDLE_FETCH_LIMIT=5                      # 每次拉取的 K 线根数
# SIGNAL_DELAY_MS=10000                     # 新周期开始后延迟多久再读取信号（毫秒）

# ═══════════════════════════════════════════
# [可选] 马丁格尔 — 默认即可
# ═══════════════════════════════════════════
# MARTINGALE_MULTIPLIER=2                   # 连亏后下注倍数
# MARTINGALE_MAX_LOSSES=4                   # 最多连续加倍次数（超过后重置为基础金额）

# ═══════════════════════════════════════════
# [可选] 风控
# ═══════════════════════════════════════════
# ORDER_PRICE_CAP=0.95                      # 买 YES/NO 对称封顶：盘口价高于阈值则按阈值限价挂单；0=不限制（旧名 YES_PRICE_MAX 仍兼容）
# 策略固定为高波动延续（S1→买跌 NO，S2→买涨 YES）；rv 阈值不再切换方向
# VOLATILITY_BAR_TIMEFRAME=1m               # 波动率 K 线（仅日志展示）
# VOLATILITY_CANDLE_LIMIT=20
# RV_5M_THRESHOLD=0.00045                   # 回测/参考用，生产不改变信号方向
# RV_15M_THRESHOLD=0.00025
# RV_RATIO_MAX=0                            # 已停用

# ═══════════════════════════════════════════
# [可选] 会话启停 — 压缩 ∧ 异动同时满足才跑脚本
# ═══════════════════════════════════════════
# SESSION_GATE_ENABLED=true                 # false=常开（与旧行为一致）
# SESSION_CANDLE_LIMIT=120                 # 评估拉取 5m K 线根数（≥96+14=110）
# VOL_COMPRESS_LOOKBACK=96                    # 压缩评估回看根数
# VOL_COMPRESS_PERCENTILE=0.40                # ATR% 低位分位阈值
# VOL_COMPRESS_MIN_BARS=12                    # 连续偏低根数
# VOL_PERIOD_RATIO_MIN=1.1                    # 1h/8h 量比下限
# VOL_SPIKE_MULT=1.3                          # 近 2 根 / 近 12 根均量倍数
# VOL_SPIKE_LOOKBACK=12
# VOL_MOMENTUM_MULT=1.1                       # 近 2 根 / 前 6 根均量倍数
# SESSION_OBSERVATION_BARS=24                 # ACTIVE 内连续评估失败才停止
# EVENT_WINDOW_ENABLED=false                  # 仅日志，不否决
# EVENT_WINDOW_HOURS=4                        # 催化窗口 ±小时
# BIG_MOVE_CONFIRM_BARS=2
# BIG_MOVE_END_BARS=3

# ═══════════════════════════════════════════
# [可选] Gamma / 调度超时 — 默认即可
# ═══════════════════════════════════════════
# GAMMA_FETCH_TIMEOUT_MS=30000              # Gamma API 单次请求超时（毫秒）
# GAMMA_FETCH_ATTEMPTS=6                    # Gamma API 最大重试次数
# GAMMA_FETCH_RETRY_DELAY_MS=3000           # Gamma API 重试间隔（毫秒）
# CYCLE_TIMEOUT_MS=90000                    # 单轮（发现市场+下单）最大耗时（毫秒）
# JSONL_MAX_BYTES=10485760                  # signals/trades 日志文件轮转阈值（字节，默认 10MB）
# LOG_LEVEL=INFO                            # 日志级别：DEBUG / INFO / WARN / ERROR

# ═══════════════════════════════════════════
# [可选] Telegram — 留空则不推送
# ═══════════════════════════════════════════
TELEGRAM_BOT_TOKEN=                         # Telegram Bot Token（@BotFather 获取）
TELEGRAM_CHAT_ID=                           # 接收通知的 Telegram Chat ID

# ═══════════════════════════════════════════
# [未使用] 以下变量当前代码不读取，请勿配置
# ═══════════════════════════════════════════
# POLY_ADDRESS=                             # 已写入 config 但运行时未使用
# POLY_BUILDER_CODE=                        # 已写入 config 但下单未传入
# BINANCE_API_KEY=                          # CCXT 公开 OHLCV 不需要；且主源默认 okx
# BINANCE_SECRET=                           # 同上，Binance API Secret（当前未使用）
