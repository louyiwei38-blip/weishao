# ─────────────────────────────────────────
# PMfanz 环境变量模板
# 说明：docs/ARCHITECTURE.md
#
# 标记：[必填-实盘] [二选一] [空跑可省略] [可选] [仅FOK] [未使用]
# 未写明的参数均有代码内默认值，可不放入 .env
#
# PM2 三开时：BOT_INSTANCE / CANDLE_TIMEFRAME / MARKET_CYCLE_MINUTES / DRY_RUN
# 由 ecosystem.config.cjs 注入（覆盖 .env 同名项）。
# 其余配置（预算、马丁、结算、OHLCV、Telegram…）一律以本文件为准。
# ─────────────────────────────────────────

# ═══════════════════════════════════════════
# [必填-实盘] 私钥 — 空跑(DRY_RUN=true)可全部省略
# ═══════════════════════════════════════════
# 方式 A：明文（仅本地开发）
# POLY_PRIVATE_KEY=0x...                    # Polymarket 钱包私钥（明文，勿提交 git）

# 方式 B：加密（服务器推荐，npm run encrypt-key）
POLY_PRIVATE_KEY_ENCRYPTED=                 # 加密后的私钥（与 POLY_KEY_PASSWORD 配对使用）
# 解密密码（与加密私钥配对；可 export 注入，勿提交 git）
# POLY_KEY_PASSWORD=                          # 解密 POLY_PRIVATE_KEY_ENCRYPTED 的密码

# ═══════════════════════════════════════════
# [可选] CLOB L2 API — 留空则启动时用私钥自动 createOrDeriveApiKey()
# 也可 npm run create-api-key 预生成（启动更快、凭证固定）
# ═══════════════════════════════════════════
# POLY_API_KEY=                               # Polymarket CLOB L2 API Key
# POLY_API_SECRET=                            # Polymarket CLOB L2 API Secret
# POLY_PASSPHRASE=                            # Polymarket CLOB L2 API Passphrase

# ═══════════════════════════════════════════
# [可选] 钱包高级 — 一般留空，程序自动检测
# ═══════════════════════════════════════════
# 资金钱包（留空 → 自动推导 deposit wallet）
# POLY_FUNDER_ADDRESS=0x...                   # Polymarket 资金/代理钱包地址（funder）
# 签名类型 0=EOA 1=PROXY 2=SAFE 3=DEPOSIT_WALLET（留空 → 自动探测）
# POLY_SIGNATURE_TYPE=3                       # 订单签名类型（留空则自动探测）

# ═══════════════════════════════════════════
# 运行模式
# ═══════════════════════════════════════════
# true=模拟下单；false=实盘
DRY_RUN=true                                # 空跑模式：true 只记录不下单，false 实盘交易

# ═══════════════════════════════════════════
# [可选] PM2 — 同机第二钱包时用 W2 前缀（见 ecosystem.wallet2.config.cjs）
# ═══════════════════════════════════════════
# PM2_NAME_PREFIX=V3                        # 默认 V3-btc-5m；第二套目录用 W2 或 npm run pm2:w2:start

# ═══════════════════════════════════════════
# [可选] 信号 K 线 — 默认即可
# ═══════════════════════════════════════════
OHLCV_EXCHANGE=okx                          # K 线数据源：okx / binance / bybit（失败自动切换）
OHLCV_MARKET_TYPE=swap                      # swap=OKX USDT 永续 1h | spot=现货
# OHLCV_SYMBOL=BTC/USDT:USDT                  # 留空则 swap 自动由 TRADING_SYMBOL 推导

# ═══════════════════════════════════════════
# [可选] 下单 — 默认 FOK 市价 + 价格封顶
# ═══════════════════════════════════════════
ORDER_TYPE=GTC                              # GTC=始终挂 best ask 限价；FOK=市价（可配合 ORDER_PRICE_CAP）
ORDER_PRICE_CAP=0.60                        # 限价封顶；GTC 时 ask 超阈值则按阈值挂；0=不限制
TRADE_BUDGET_USD=10                         # 动态首注：跟上目标线时的默认投入
MAX_BET_USD=30                              # 单笔硬上限（与 BANKROLL_STAKE_MAX_USD 取较小）
# BANKROLL_STEP_USD=10                      # 目标线步进：目标 = 本金 + 净胜负 × step；补层 T = L + step
# BANKROLL_CATCHUP_T_CAP=20                 # 补层目标净利 T 硬上限
# BANKROLL_STAKE_MAX_USD=30                 # 动态仓位单笔上限
# 落后时用补队列：出手层 L，T=L+step，stake=T×p/(1-p)；输只登记新层，赢才推进
# 以下有默认值，一般不必改：
# MIN_BALANCE_USD=0                         # 钱包余额低于此值时停止交易（美元）
# MAX_DAILY_LOSS_USD=10000                  # 当日累计亏损达此值时停止交易（美元）
# LIMIT_PRICE_OFFSET_TICKS=0                # 限价单相对最优卖价的 tick 偏移（0=挂在最优卖价）
# FILL_SYNC_POLL_MS=500                     # 下单后轮询成交状态的间隔（毫秒）
# FILL_SYNC_MAX_WAIT_MS=8000                # 下单后等待成交同步的最长时间（毫秒）

# [仅 FOK 市价单生效；GTC 可忽略]
# ORDER_FILL_ATTEMPTS=8                     # FOK 未成交时的最大重试次数
# ORDER_RETRY_DELAY_MS=1000                 # FOK 重试间隔（毫秒；默认 1s，尽快重试）

# ═══════════════════════════════════════════
# [可选] Chainlink 结算 — 默认即可
# ═══════════════════════════════════════════
SETTLE_SOURCE=chainlink                     # okx | chainlink — 实盘推荐 chainlink（Polymarket 官方 oracle）
# CHAINLINK_SETTLE_BUFFER_MS=1500           # 周期结束后等待结算价的缓冲（毫秒；默认 1.5s）
# CHAINLINK_SETTLE_MAX_WAIT_MS=15000        # 等待 Chainlink 结算价的最长时间（毫秒）
# CHAINLINK_OPEN_WINDOW_MS=5000             # 周期开盘价采集窗口（周期开始后毫秒数）
# CHAINLINK_BUFFER_MINUTES=30               # Chainlink RTDS 价格历史缓存时长（分钟）
# CHAINLINK_SAFETY_INTERVAL_MS=60000        # 结算守护进程的安全检查间隔（毫秒）

# ═══════════════════════════════════════════
# [可选] 策略 — 维加斯通道 EMA144/169；多标的只改这里
# ═══════════════════════════════════════════
# PM2 实例：默认单标的 × 单周期（改完后 pm2 delete all && npm run pm2:start）
TRADING_SYMBOLS=BTC                         # 单标的；如需多标的: BTC,ETH
CANDLE_TIMEFRAMES=5m                        # 单周期；如需多周期: 5m,15m,1h
# 单进程(npm start)仍用 TRADING_SYMBOL；PM2 会按上表为每个进程注入 TRADING_SYMBOL
TRADING_SYMBOL=BTC/USDT                     # 单进程默认；PM2 启动时由 ecosystem 覆盖
# CANDLE_TIMEFRAME=5m                       # 单进程默认；PM2 时由 ecosystem 覆盖
# MARKET_CYCLE_MINUTES=60                   # 可省略：默认由 CANDLE_TIMEFRAME 推导（5m→5, 15m→15, 1h→60）
# BOT_INSTANCE=1h                           # 多实例隔离状态文件后缀（默认=CANDLE_TIMEFRAME）
# CANDLE_FETCH_LIMIT=200                    # 每次拉取的 K 线根数（通道 EMA 已改由 OKX 指标接口提供）
# SIGNAL_DELAY_MS=                          # 新信号延迟；默认按周期：5m→3000 / 15m→4000 / 1h→5000
# IN_CHAIN_SIGNAL_DELAY_MS=100              # in_chain 续单延迟（无需等 K 线；快路径未命中时的边界延迟）
# PREWARM_MS=5000                           # 周期边界前提前预热 Gamma/CLOB/余额
# MG_CONT_FAST_PATH=true                    # 结算输后立即同向续单（连亏未满 5；TG 不挡下单）
# MIN_TRADE_REMAINING_MS=15000              # 周期剩余不足此时长则不再下单
# SIGNAL_DATA_RETRY_MS=800                  # K 线未新鲜 / EMA 未对齐时的重试间隔
# SIGNAL_DATA_MAX_WAIT_MS=60000             # 周期内等待数据就绪的最长时间（仍会预留下单窗口）

# ═══════════════════════════════════════════
# [可选] 马丁格尔 — 默认即可
# ═══════════════════════════════════════════
# MARTINGALE_MULTIPLIER=1                   # 连亏后下注倍数（实盘仓位由动态首注重算，倍数仅兼容）
# MARTINGALE_MAX_LOSSES=5                   # 最多连续亏损次数（超过后停链路回 need_outside；不重置本金 P / 净胜负 N）

# ═══════════════════════════════════════════
# [可选] 风控
# ═══════════════════════════════════════════
# 旧名 YES_PRICE_MAX 仍兼容 ORDER_PRICE_CAP
# 策略：维加斯通道穿越入场（上穿入→UP，下穿入→DOWN）+ 同向马丁

# ═══════════════════════════════════════════
# [可选] Gamma / 调度超时 — 默认即可
# ═══════════════════════════════════════════
# GAMMA_FETCH_TIMEOUT_MS=30000              # Gamma API 单次请求超时（毫秒）
# GAMMA_FETCH_ATTEMPTS=6                    # Gamma API 最大重试次数
# GAMMA_FETCH_RETRY_DELAY_MS=3000           # Gamma API 重试间隔（毫秒）
# CYCLE_TIMEOUT_MS=90000                    # 单轮（发现市场+下单）最大耗时（毫秒）
# JSONL_MAX_BYTES=10485760                  # signals/trades 日志文件轮转阈值（字节，默认 10MB）
# LOG_LEVEL=INFO                            # 日志级别：DEBUG / INFO / WARN / ERROR

# ═══════════════════════════════════════════
# [可选] Telegram — 留空则不推送
# ═══════════════════════════════════════════
TELEGRAM_BOT_TOKEN=                         # Telegram Bot Token（@BotFather 获取）
TELEGRAM_CHAT_ID=                           # 论坛群 Chat ID（通常 -100...；先开 Topics）
# 每个实例一个话题 thread id（用 node scripts/setup-telegram-topics.js 生成；随 TRADING_SYMBOLS 自动扩展）：
# TELEGRAM_THREAD_BTC_5M=
# TELEGRAM_THREAD_BTC_15M=
# TELEGRAM_THREAD_BTC_1H=
# TELEGRAM_THREAD_ETH_5M=
# TELEGRAM_THREAD_ETH_15M=
# TELEGRAM_THREAD_ETH_1H=
# TELEGRAM_CALLBACK_POLL_MS=2000          # 轮询 TG 按钮 callback 间隔（毫秒）
# TELEGRAM_BUTTON_VALIDITY_MS=3600000     # 推送消息内按钮有效期（默认 1 小时）
# TELEGRAM_RESET_INSTANCE=btc-5m          # 仅该实例可执行「重置本金/净胜负」

# ═══════════════════════════════════════════
# [未使用] 以下变量当前实盘代码不读取，请勿配置
# ═══════════════════════════════════════════
# POLY_ADDRESS=                             # 已写入 config 但运行时未使用
# POLY_BUILDER_CODE=                        # 已写入 config 但下单未传入
# BINANCE_API_KEY=                          # CCXT 公开 OHLCV 不需要；且主源默认 okx
# BINANCE_SECRET=                           # 同上，Binance API Secret（当前未使用）
# SESSION_GATE_ENABLED / ACTIVITY_* / MIN_OPEN_TIERS / VOLATILITY_* / RV_*  # 已从实盘移除
